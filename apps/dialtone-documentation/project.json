{
  "name": "dialtone-documentation",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "dialtone-css:build",
        "dialtone-icons:build",
        "dialtone-tokens:build",
        "dialtone-vue:build",
        "dialtone-combinator:build"
      ],
      "inputs": [
        "{projectRoot}/docs/**/*",
        "!{projectRoot}/docs/.vuepress/.cache",
        "!{projectRoot}/docs/.vuepress/.temp",
        "!{projectRoot}/docs/.vuepress/dist"
      ],
      "outputs": ["{projectRoot}/docs/.vuepress/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/generate-raw-markdown.mjs && NODE_OPTIONS='--max-old-space-size=8192' vuepress build docs"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "dialtone-css:build",
        "dialtone-icons:build",
        "dialtone-tokens:build",
        "dialtone-vue:build",
        "dialtone-combinator:build"
      ],
      "inputs": [
        "{projectRoot}/docs/**/*",
        "{projectRoot}/package.json"
      ],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "nx run dialtone-css:startWatch"
          },
          {
            "command": "nx watch --projects=dialtone-tokens,dialtone-vue,dialtone-combinator -- nx run \\$NX_PROJECT_NAME:build"
          },
          {
            "command": "node scripts/generate-raw-markdown.mjs && vuepress dev docs"
          }
        ]
      }
    }
  }
}
