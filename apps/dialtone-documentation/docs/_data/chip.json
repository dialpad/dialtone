{
  "classes": [
    {
      "class": "d-chip",
      "applies": "N/A",
      "description": "Container for the chip button and close button elements."
    },
    {
      "class": "d-chip__label",
      "applies": "N/A",
      "description": "Default chip styling"
    },
    {
      "class": "d-chip__label--people",
      "applies": ".d-chip__label",
      "description": "Applies people classification styling."
    },
    {
      "class": "d-chip__label--subtle",
      "applies": ".d-chip__label",
      "description": "Applies content-only subtle styling."
    },
    {
      "class": "d-chip__label--strong",
      "applies": ".d-chip__label",
      "description": "Applies strong emphasis styling."
    },
    {
      "class": "d-chip__label--size-{$size}",
      "applies": ".d-chip__label",
      "description": "Applies the numeric size (100 to 700)."
    },
    {
      "class": "d-chip__label--sm",
      "applies": ".d-chip",
      "description": "Deprecated alias for size 200."
    },
    {
      "class": "d-chip__label--xs",
      "applies": ".d-chip",
      "description": "Deprecated alias for size 100."
    },
    {
      "class": "d-chip__label--focus-always",
      "applies": ".d-chip__label",
      "description": "Shows the focus ring for pointer focus as well as keyboard focus."
    },
    {
      "class": "d-chip__avatar",
      "applies": "N/A",
      "description": "Applies positioning and styling for the chip avatar."
    },
    {
      "class": "d-chip__close",
      "applies": "N/A",
      "description": "Applies positioning and styling for the chip close button."
    },
    {
      "class": "d-chip__close--sm",
      "applies": ".d-chip-close-btn",
      "description": "Small close button."
    },
    {
      "class": "d-chip__close--xs",
      "applies": ".d-chip-close-btn",
      "description": "Extra small close button."
    },
    {
      "class": "d-chip__leading",
      "applies": "Child of .d-chip__label",
      "description": "Freeform leading content."
    },
    {
      "class": "d-chip__trailing",
      "applies": "Child of .d-chip__label",
      "description": "Freeform trailing content."
    },
    {
      "class": "d-chip__icon",
      "applies": "Child of .d-chip__label",
      "description": "Start icon container."
    },
    {
      "class": "d-chip__end-icon",
      "applies": "Child of .d-chip__label",
      "description": "End icon container."
    }
  ]
}
