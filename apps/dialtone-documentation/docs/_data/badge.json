{
  "classes": [
    {
      "class": "d-badge",
      "applies": "N/A",
      "description": "Base badge style"
    },
    {
      "class": "d-badge--count",
      "applies": ".d-badge",
      "description": "Applies count variant shape."
    },
    {
      "class": "d-badge--pre-release",
      "applies": ".d-badge",
      "description": "Applies pre-release (purple) colors."
    },
    {
      "class": "d-badge--release",
      "applies": ".d-badge",
      "description": "Applies release (gray) colors."
    },
    {
      "class": "d-badge--{$lifecycle}",
      "applies": ".d-badge",
      "description": "Applies the status color for a lifecycle variant: draft, edited, unsaved, saved, published, archived, or scheduled."
    },
    {
      "class": "d-badge--strong",
      "applies": ".d-badge",
      "description": "Applies strong emphasis colors."
    },
    {
      "class": "d-badge--size-{$size}",
      "applies": ".d-badge",
      "description": "Applies numeric label typography size."
    },
    {
      "class": "d-badge--info",
      "applies": ".d-badge",
      "description": "Applies light blue background color."
    },
    {
      "class": "d-badge--positive",
      "applies": ".d-badge",
      "description": "Applies light green background color."
    },
    {
      "class": "d-badge--warning",
      "applies": ".d-badge",
      "description": "Applies light yellow background color."
    },
    {
      "class": "d-badge--critical",
      "applies": ".d-badge",
      "description": "Applies light red background color."
    },
    {
      "class": "d-badge--bulletin",
      "applies": ".d-badge",
      "description": "Deprecated alias for pre-release styling."
    },
    {
      "class": "d-badge--ai",
      "applies": ".d-badge",
      "description": "Applies Dialpad Ai's purple/magenta background gradient."
    },
    {
      "class": "d-badge--decorate-{$color}",
      "applies": ".d-badge",
      "description": "Styles the decoration shape color."
    },
    {
      "class": "d-badge__label",
      "applies": "Child of .d-badge",
      "description": "Text label"
    },
    {
      "class": "d-badge__decorative",
      "applies": "Child of .d-badge",
      "description": "Decorative color shape"
    },
    {
      "class": "d-badge__leading",
      "applies": "Child of .d-badge",
      "description": "Freeform leading content, such as another badge"
    },
    {
      "class": "d-badge__trailing",
      "applies": "Child of .d-badge",
      "description": "Freeform trailing content, such as a nested badge"
    },
    {
      "class": "d-badge__icon-left",
      "applies": "Child of .d-badge",
      "description": "Start icon container"
    },
    {
      "class": "d-badge__icon-right",
      "applies": "Child of .d-badge",
      "description": "End icon container"
    }
  ]
}
