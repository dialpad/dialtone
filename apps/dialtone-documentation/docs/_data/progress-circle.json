      "applies": ".d-progress-circle",
      "description": "Applies success color."
    },
    {
      "class": "d-progress-circle--warning",
      "applies": ".d-progress-circle",
      "description": "Applies warning color."
    },
    {
      "class": "d-progress-circle--info",
      "applies": ".d-progress-circle",
      "description": "Applies info color."
    },
    {
      "class": "d-progress-circle--ai",
