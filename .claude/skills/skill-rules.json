{
  "$schema": "Dialtone Skill Auto-Activation Rules",
  "version": "1.0",
  "skills": {
    "vue-conventions": {
      "type": "guardrail",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Vue Composition API and component conventions",
      "promptTriggers": {
        "keywords": ["component", "vue", "script setup", "defineProps", "Options API", "Composition API", "props", "emits", "slots"],
        "intentPatterns": [
          "(create|add|update|modify|edit|change|refactor).*?component",
          "(edit|change|create|modify).*?\\.vue",
          "new.*?(component|vue)"
        ]
      }
    },
    "component": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Component creation and update pipeline",
      "promptTriggers": {
        "keywords": ["component", "scaffold", "new component", "update component", "modify component", "DtButton", "DtModal"],
        "intentPatterns": [
          "(create|add|scaffold|update|build|implement).*?component",
          "new.*?Dt[A-Z]"
        ]
      }
    },
    "utility": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "CSS utility class creation and updates",
      "promptTriggers": {
        "keywords": ["utility class", "CSS class", "d-", "less", "spacing", "color utility", "css utility"],
        "intentPatterns": [
          "(create|add|update|modify).*?(utility|css|class)",
          "new.*?(utility|css class)"
        ]
      }
    },
    "token": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Design token creation and updates",
      "promptTriggers": {
        "keywords": ["token", "design token", "CSS variable", "--dt-", "dark mode", "theme", "color token"],
        "intentPatterns": [
          "(create|add|update|modify).*?token",
          "new.*?token",
          "(add|change|update).*?(color|spacing|font|shadow)"
        ]
      }
    },
    "commit": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Commit workflow with Jira integration",
      "promptTriggers": {
        "keywords": ["commit", "ready to commit", "stage", "git add", "git commit"],
        "intentPatterns": [
          "(ready to|about to|let'?s|please).*?commit",
          "commit.*?(change|work|code)"
        ]
      }
    },
    "separation-of-concerns": {
      "type": "guardrail",
      "enforcement": "warn",
      "priority": "medium",
      "description": "MVC-style separation enforcement for Vue components",
      "promptTriggers": {
        "keywords": ["business logic", "separation", "MVC", "presentation", "template logic", "inline style"],
        "intentPatterns": [
          "(move|extract|separate).*?(logic|code).*?(template|component)",
          "(refactor|clean|organize).*?component"
        ]
      }
    },
    "component-testing": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Vue component testing with Vitest",
      "promptTriggers": {
        "keywords": ["test", "spec", "vitest", "mount", "wrapper", "coverage", "unit test"],
        "intentPatterns": [
          "(create|write|add|update).*?test",
          "test.*?(component|vue|prop)",
          "(fix|debug).*?test"
        ]
      }
    },
    "analyze": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "low",
      "description": "Pattern audit and consistency checking",
      "promptTriggers": {
        "keywords": ["audit", "analyze", "check patterns", "consistency", "validate vs validator", "inconsistency"],
        "intentPatterns": [
          "(check|audit|analyze|review).*?(component|pattern|consistency|convention)",
          "find.*?(inconsistenc|bug|issue)"
        ]
      }
    }
  },
  "scoring": {
    "keywordWeight": 2,
    "intentPatternWeight": 3,
    "activationThreshold": 2
  }
}
