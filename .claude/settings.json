{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          ".claude/hooks/strip-coauthor.sh",
          ".claude/hooks/commit-format.sh"
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          ".claude/hooks/branch-protection.sh"
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          ".claude/hooks/skill-activation.sh"
        ]
      }
    ]
  }
}
