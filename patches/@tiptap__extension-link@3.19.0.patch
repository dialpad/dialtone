diff --git a/dist/index.cjs b/dist/index.cjs
index b7357fa4c6e559fdad26bb04eed205af9e5b524b..5f81ff2601281fd18b200e0de632e61c01802316 100644
--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -43,10 +43,26 @@ var UNICODE_WHITESPACE_REGEX_END = new RegExp(`${UNICODE_WHITESPACE_PATTERN}$`);
 var UNICODE_WHITESPACE_REGEX_GLOBAL = new RegExp(UNICODE_WHITESPACE_PATTERN, "g");
 
 // src/helpers/autolink.ts
+// dialtone patch: a lone trailing/leading bracket (e.g. the ")" in
+// "(like https://dialpad.design/)") previously made isValidLinkStructure
+// reject the whole match, so no link was added at all even though linkifyjs
+// correctly identified the URL boundary. Accept a 2-token split as long as
+// the leftover token is pure bracket/punctuation, so it doesn't also start
+// accepting genuinely invalid trailing content like "example.com1".
+var TRAILING_PUNCTUATION_REGEX = /^[)\]}>,.;:!?'"]+$/;
+var LEADING_PUNCTUATION_REGEX = /^[([{<"']+$/;
 function isValidLinkStructure(tokens) {
   if (tokens.length === 1) {
     return tokens[0].isLink;
   }
+  if (tokens.length === 2) {
+    if (tokens[0].isLink && TRAILING_PUNCTUATION_REGEX.test(tokens[1].value)) {
+      return true;
+    }
+    if (tokens[1].isLink && LEADING_PUNCTUATION_REGEX.test(tokens[0].value)) {
+      return true;
+    }
+  }
   if (tokens.length === 3 && tokens[1].isLink) {
     return ["()", "[]"].includes(tokens[0].value + tokens[2].value);
   }
