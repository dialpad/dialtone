{
  "name": "dialtone-query-core",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "dialtone-css:build",
        "dialtone-vue:build",
        "dialtone-docs:build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/scripts/**/*",
        "!{projectRoot}/src/generated/**",
        {
          "dependentTasksOutputFiles": "**/*.json",
          "transitive": true
        }
      ],
      "outputs": ["{projectRoot}/build", "{projectRoot}/src/generated"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/build-bundled-provenance.mjs && pnpm exec tsc"
      }
    },
    "test": {
      "executor": "nx:run-script",
      "dependsOn": ["build"],
      "options": {
        "script": "test"
      }
    }
  }
}
