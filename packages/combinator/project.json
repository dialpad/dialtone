{
  "name": "dialtone-combinator",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "dialtone-css:build",
        "dialtone-icons:build",
        "dialtone-vue:build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/vite.config.js"
      ],
      "outputs": [ "{projectRoot}/dist" ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "dialtone-css:build",
        "dialtone-icons:build",
        "dialtone-tokens:build",
        "dialtone-vue:build"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "nx watch --projects=dialtone-css,dialtone-icons,dialtone-tokens,dialtone-vue --includeDependentProjects -- nx run \\$NX_PROJECT_NAME:build"
          },
          {
            "command": "vite"
          }
        ]
      }
    },
    "test": {
      "executor": "nx:run-script",
      "dependsOn": [
        "dialtone-vue:build"
      ],
      "options": {
        "script": "test"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm semantic-release-plus --extends ./packages/combinator/release-ci.config.cjs && sleep 3",
        "parallel": false
      }
    },
    "generate-examples": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "dialtone-vue:build",
        "dialtone-icons:build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/*.mjs",
        "{projectRoot}/vite.config.js",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/scripts/lib/**/*.mjs",
        "{workspaceRoot}/scripts/retrieval/example-consumer.mjs",
        "{workspaceRoot}/packages/dialtone-docs/src/generators/example-template.mjs",
        "{workspaceRoot}/scripts/build-dialtone-vue-docs.mjs",
        "{workspaceRoot}/packages/dialtone-vue/{common,components,directives,prototypes}/**/*",
        "{workspaceRoot}/packages/dialtone-vue/index.js",
        "{workspaceRoot}/packages/dialtone-vue/package.json",
        "{workspaceRoot}/packages/dialtone-vue/dist/component-documentation.json",
        "{workspaceRoot}/packages/dialtone-icons/src/**/*.svg",
        "{workspaceRoot}/packages/dialtone-icons/package.json",
        {
          "dependentTasksOutputFiles": "**/dist/**/*",
          "transitive": true
        }
      ],
      "outputs": [ "{projectRoot}/.generated/preset-examples.json" ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/generate-preset-examples.mjs"
      }
    }
  }
}
