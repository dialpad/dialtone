{
  "name": "dialtone-docs",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node src/generators/build.mjs"
      }
    },
    "test": {
      "executor": "nx:run-script",
      "options": { "script": "test" }
    }
  }
}
