{
  "name": "dialtone-docs",
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "dependsOn": ["dialtone-combinator:generate-examples"],
      "options": {
        "script": "build:content"
      },
      "inputs": [
        { "dependentTasksOutputFiles": "**/.generated/preset-examples.json", "transitive": true },
        "{projectRoot}/package.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/apps/dialtone-documentation/package.json",
        "{workspaceRoot}/packages/dialtone-css/package.json",
        { "externalDependencies": ["markdown-it"] },
        "{projectRoot}/src/**",
        "{workspaceRoot}/apps/dialtone-documentation/package.json",
        "{workspaceRoot}/apps/dialtone-documentation/docs/.vuepress/plugins/fenced-demo-shared.js",
        "{workspaceRoot}/scripts/retrieval/profiles.mjs",
        "{workspaceRoot}/apps/dialtone-documentation/docs/**/*.md",
        "{workspaceRoot}/scripts/lib/vue-component-identity.mjs",
        "{workspaceRoot}/scripts/lib/component-name.mjs",
        "{workspaceRoot}/scripts/lib/preset-example-id.mjs",
        "{workspaceRoot}/packages/dialtone-vue/index.js",
        "{workspaceRoot}/packages/dialtone-vue/components/**/index.js",
        "{workspaceRoot}/packages/dialtone-vue/package.json",
        "{workspaceRoot}/apps/dialtone-documentation/scripts/lib/frontmatter.mjs",
        "{workspaceRoot}/apps/dialtone-documentation/scripts/lib/source-page.mjs",
        "{workspaceRoot}/apps/dialtone-documentation/docs/.vuepress/site-reference.js",
        "{workspaceRoot}/packages/dialtone-vue/directives/**/*.mdx",
        "{workspaceRoot}/packages/dialtone-vue/directives/**/*.stories.js",
        "{workspaceRoot}/packages/dialtone-vue/directives/**/index.js",
        "{workspaceRoot}/packages/dialtone-icons/package.json",
        "{workspaceRoot}/scripts/retrieval/example-consumer.mjs",
        { "dependentTasksOutputFiles": "**/dist/component-documentation.json", "transitive": true },
        { "dependentTasksOutputFiles": "**/vue/dist/**/*", "transitive": true }
      ],
      "outputs": [
        "{projectRoot}/dist/**"
      ]
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      }
    },
    "check-freshness": {
      "executor": "nx:run-script",
      "options": {
        "script": "check-freshness"
      }
    }
  }
}
