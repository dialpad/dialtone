{
  "name": "dialtone-docs",
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": { "script": "build" },
      "inputs": [
        "{projectRoot}/src/**",
        "{workspaceRoot}/apps/dialtone-documentation/docs/**/*.md",
        "{workspaceRoot}/packages/dialtone-vue/directives/**/*.mdx",
        "{workspaceRoot}/packages/dialtone-vue/directives/**/*.stories.js",
        "{workspaceRoot}/packages/dialtone-vue/index.js",
        "{workspaceRoot}/packages/dialtone-vue/package.json"
      ],
      "outputs": ["{projectRoot}/dist/**"]
    },
    "test": {
      "executor": "nx:run-script",
      "options": { "script": "test" }
    },
    "check-freshness": {
      "executor": "nx:run-script",
      "options": { "script": "check-freshness" }
    }
  }
}
