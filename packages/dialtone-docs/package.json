{
  "name": "@dialpad/dialtone-docs",
  "version": "1.0.0",
  "description": "Documentation generation and validation for Dialtone",
  "type": "module",
  "scripts": {
    "build": "node src/generators/build-ai-docs.mjs && node src/generators/build-public-docs.mjs && node src/generators/build-component-doc-links.mjs",
    "check-freshness": "node src/generators/check-freshness.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "vitest": "^4.1.0"
  },
  "exports": {
    "./dist/public-docs.json": "./dist/public-docs.json",
    "./dist/component-doc-links.json": "./dist/component-doc-links.json"
  },
  "keywords": [
    "documentation",
    "ai",
    "dialtone"
  ],
  "license": "MIT"
}
