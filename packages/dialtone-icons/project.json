{
  "name": "dialtone-icons",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "pnpm exec gulp"
          },
          {
            "command": "nx run-many --target=build --projects=dialtone-icons-vue2,dialtone-icons-vue3 --parallel=2 --output-style=stream"
          },
          "brew install ComposeGears/repo/valkyrie",
          "rm -rf dist/android",
          "valkyrie iconpack --output-path=./dist/android/kotlin/icons --package-name=dialtone.dialpad.icons --iconpack-name=DialtoneIcons",
          "valkyrie svgxml2imagevector --input-path=./dist/svg/icons --output-path=./dist/android/kotlin/icons --package-name=dialtone.dialpad.icons --iconpack-name=DialtoneIcons"
        ],
        "parallel": false
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/transformSVGtoVue.cjs",
        "{projectRoot}/gulpfile.cjs"
      ],
      "outputs": [
        "{projectRoot}/src/icons",
        "{projectRoot}/src/illustrations",
        "{projectRoot}/dist",
        "{projectRoot}/vue2/dist",
        "{projectRoot}/vue3/dist"
      ]
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm publish --filter ./packages/dialtone-icons"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm semantic-release-plus --extends ./packages/dialtone-icons/release-ci.config.cjs && sleep 3",
        "parallel": false
      }
    },
    "publish:android-package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}/android",
        "commands": [
          "cp ./AndroidManifest.xml ./../dist/android && ./gradlew publishToMavenLocal -Pversion=0.0.1"
        ],
        "parallel": false
      }
    }
  }
}
