{
  "name": "dialtone-icons-vue",
  "targets": {
    "clean-dist": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "rm -rf ./dist"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["clean-dist"],
      "inputs": [
        "{workspaceRoot}/packages/dialtone-icons/src/**/*.{cjs,mjs,js,json,svg,vue}",
        "{workspaceRoot}/packages/dialtone-icons/transformSVGtoVue.cjs",
        "{workspaceRoot}/packages/dialtone-icons/gulpfile.cjs",
        "{projectRoot}/vite.config.js"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec vite build"
      }
    }
  }
}
