{
  "name": "dialtone-cli",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["dialtone-query-core:build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/rollup.config.js",
        "{workspaceRoot}/packages/dialtone-docs/scripts/check-example-guidance.mjs",
        { "dependentTasksOutputFiles": "**/*.{js,json,d.ts}", "transitive": true }
      ],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec rollup -c && node ../dialtone-docs/scripts/check-example-guidance.mjs --copy-to dialtone-cli"
      }
    },
    "test": {
      "executor": "nx:run-script",
      "dependsOn": ["build"],
      "options": { "script": "test" }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm publish --filter ./packages/dialtone-cli"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm semantic-release-plus --extends ./packages/dialtone-cli/release-ci.config.cjs && sleep 3",
        "parallel": false
      }
    }
  }
}
