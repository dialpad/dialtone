{
  "name": "@dialpad/dialtone-react",
  "version": "0.0.0",
  "private": true,
  "description": "Dialtone React components, ported from dialtone-vue",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "test": "node scripts/build-icons.mjs && vitest run",
    "typecheck": "node scripts/build-icons.mjs && tsc -p tsconfig.json",
    "gate": "node scripts/build-icons.mjs && node parity/gate.mjs"
  },
  "peerDependencies": {
    "react": ">=19.2",
    "react-dom": ">=19.2"
  },
  "dependencies": {
    "@dialpad/dialtone-icons": "workspace:*",
    "tippy.js": "6.3.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "html-react-parser": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
