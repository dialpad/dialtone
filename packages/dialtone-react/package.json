{
  "name": "@dialpad/dialtone-react",
  "version": "0.0.0",
  "private": true,
  "description": "Dialtone React components, ported from dialtone-vue",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/dialtone-react.js",
  "module": "./dist/dialtone-react.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dialtone-react.js"
    },
    "./icons": {
      "types": "./dist/types/icons/index.d.ts",
      "import": "./dist/icons.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/build-icons.mjs && node scripts/build-index.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-icons.mjs && node scripts/build-index.mjs && vite build -c vite.build.config.ts",
    "lint": "eslint .",
    "test": "node scripts/build-icons.mjs && node scripts/build-index.mjs && vitest run",
    "typecheck": "node scripts/build-icons.mjs && node scripts/build-index.mjs && tsc -p tsconfig.json",
    "gate": "node scripts/build-icons.mjs && node scripts/build-index.mjs && node parity/gate.mjs"
  },
  "peerDependencies": {
    "@dialpad/dialtone-css": "workspace:^",
    "react": ">=19.2",
    "react-dom": ">=19.2"
  },
  "dependencies": {
    "@dialpad/dialtone-emojis": "workspace:*",
    "@dialpad/dialtone-icons": "workspace:*",
    "@floating-ui/dom": "1.7.6",
    "@fluent/bundle": "0.17.1",
    "@tiptap/core": "3.19.0",
    "@tiptap/extension-blockquote": "3.19.0",
    "@tiptap/extension-bold": "3.19.0",
    "@tiptap/extension-bubble-menu": "3.19.0",
    "@tiptap/extension-bullet-list": "3.19.0",
    "@tiptap/extension-code": "3.19.0",
    "@tiptap/extension-code-block": "3.19.0",
    "@tiptap/extension-color": "3.19.0",
    "@tiptap/extension-document": "3.19.0",
    "@tiptap/extension-floating-menu": "3.19.0",
    "@tiptap/extension-font-family": "3.19.0",
    "@tiptap/extension-hard-break": "3.19.0",
    "@tiptap/extension-history": "3.19.0",
    "@tiptap/extension-image": "3.19.0",
    "@tiptap/extension-italic": "3.19.0",
    "@tiptap/extension-link": "3.19.0",
    "@tiptap/extension-list": "3.19",
    "@tiptap/extension-list-item": "3.19.0",
    "@tiptap/extension-mention": "3.19.0",
    "@tiptap/extension-ordered-list": "3.19.0",
    "@tiptap/extension-paragraph": "3.19.0",
    "@tiptap/extension-placeholder": "3.19.0",
    "@tiptap/extension-strike": "3.19.0",
    "@tiptap/extension-text": "3.19.0",
    "@tiptap/extension-text-align": "3.19.0",
    "@tiptap/extension-text-style": "3.19.0",
    "@tiptap/extension-underline": "3.19.0",
    "@tiptap/extensions": "3.19",
    "@tiptap/pm": "3.19.0",
    "@tiptap/react": "3.19.0",
    "@tiptap/static-renderer": "3.19.0",
    "@tiptap/suggestion": "3.19.0",
    "date-fns": "4.1.0",
    "deep-equal": "2.2.3",
    "emoji-toolkit": "9.0.1",
    "linkifyjs": "4.3.2",
    "overlayscrollbars": "2.10.0",
    "regex-combined-emojis": "1.6.0",
    "tippy.js": "6.3.7"
  },
  "devDependencies": {
    "@dialpad/dialtone-css": "workspace:*",
    "@dialpad/dialtone-tokens": "workspace:*",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "10.3.0",
    "@storybook/addon-links": "10.3.0",
    "@storybook/react-vite": "10.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/deep-equal": "1.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vueless/storybook-dark-mode": "^10.0.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "16.3.0",
    "html-react-parser": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
