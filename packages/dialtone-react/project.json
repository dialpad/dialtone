{
  "name": "dialtone-react",
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "dependsOn": ["dialtone-icons:build"],
      "inputs": ["default", "^default", "{workspaceRoot}/packages/dialtone-vue/localization/*.ftl"],
      "outputs": ["{projectRoot}/dist"],
      "options": { "script": "build" }
    },
    "lint": {
      "executor": "nx:run-script",
      "options": { "script": "lint" }
    },
    "test": {
      "executor": "nx:run-script",
      "dependsOn": ["dialtone-icons:build"],
      "options": { "script": "test" }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "dependsOn": ["dialtone-icons:build", "dialtone-tokens:build"],
      "options": { "script": "typecheck" }
    },
    "gate": {
      "executor": "nx:run-script",
      "dependsOn": ["dialtone-icons:build", "dialtone-tokens:build"],
      "options": { "script": "gate" }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["dialtone-css:build", "dialtone-icons:build", "dialtone-tokens:build"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "nx watch --projects=dialtone-css,dialtone-tokens -- nx run \\$NX_PROJECT_NAME:build",
          "node scripts/build-icons.mjs && STORYBOOK_ENV=development pnpm exec storybook dev -p 9012 --exact-port"
        ]
      }
    },
    "storybook:compare": {
      "executor": "nx:run-commands",
      "dependsOn": ["dialtone-css:build", "dialtone-tokens:build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node compare/generate-stories.mjs && pnpm exec storybook dev -c compare/.storybook -p 9013 --exact-port"
      }
    },
    "storybook:ports": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node compare/check-ports.mjs"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["dialtone-css:build", "dialtone-icons:build", "dialtone-tokens:build"],
      "outputs": ["{projectRoot}/storybook-static"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/build-icons.mjs && STORYBOOK_ENV=production pnpm exec storybook build -o storybook-static"
      }
    },
    "build-storybook:compare": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook", "dialtone-css:build", "dialtone-tokens:build", "dialtone-vue:build-storybook"],
      "outputs": ["{projectRoot}/storybook-static-compare"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node compare/generate-stories.mjs --vue-index ../dialtone-vue/storybook-static/index.json --react-index storybook-static/index.json && STORYBOOK_COMPARE_PUBLISHED=true pnpm exec storybook build -c compare/.storybook -o storybook-static-compare"
      }
    },
    "storybook:all": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "storybook:ports" }, "dialtone-css:build", "dialtone-icons:build", "dialtone-tokens:build", "dialtone-vue:build-functions"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "BROWSER=none nx run dialtone-vue:start",
          "node scripts/build-icons.mjs && STORYBOOK_ENV=development pnpm exec storybook dev -p 9012 --exact-port --no-open",
          "node compare/generate-stories.mjs && pnpm exec storybook dev -c compare/.storybook -p 9013 --exact-port"
        ]
      }
    }
  }
}
