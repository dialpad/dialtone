{
  "name": "dialtone-language-server",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "dialtone-vue3:build",
        "dialtone-tokens:build",
        "dialtone-css:build"
      ],
      "inputs": [
        "{projectRoot}/**/*"
      ],
      "outputs": [ "{projectRoot}/vscode/dist" ],
      "options": {
        "cwd": "{projectRoot}/vscode",
        "command": "pnpm run build"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{projectRoot}/vscode",
        "command": "pnpm vsce package --out vscode-dialtone.vsix --pre-release"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "dependsOn": [ "pack" ],
      "options": {
        "commands": [
          "pnpm semantic-release-plus --extends ./packages/language-server/server/release-ci.config.cjs && sleep 3",
          "pnpm semantic-release-plus --extends ./packages/language-server/vscode/release-ci.config.cjs && sleep 3"
        ],
        "parallel": false
      }
    }
  }
}
