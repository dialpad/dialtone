{
  "name": "dialtone-mcp-server",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["dialtone-query-core:build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/client-rules.json",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/rollup.config.js",
        "{workspaceRoot}/packages/dialtone-docs/scripts/check-example-guidance.mjs",
        { "dependentTasksOutputFiles": "**/*.{js,json,d.ts}", "transitive": true }
      ],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec rollup -c && node ../dialtone-docs/scripts/check-example-guidance.mjs --copy-to dialtone-mcp-server"
      }
    },
    "test-protocol": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import tsx --test scripts/query-tools.test.mjs scripts/project-context.test.mjs"
      }
    },
    "test-startup": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test tests/startup.test.mjs"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node build/index.js"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec ts-node src/index.ts"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm publish --filter ./packages/dialtone-mcp-server"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm semantic-release-plus --extends ./packages/dialtone-mcp-server/release-ci.config.cjs && sleep 3",
        "parallel": false
      }
    }
  }
}
