{
  "name": "@dialpad/dialtone-vue",
  "version": "3.192.1",
  "description": "Vue component library for Dialpad's design system Dialtone",
  "scripts": {
    "lint": "run-s lint:code lint:docs",
    "lint:code": "eslint .",
    "lint:docs": "markdownlint '**/*.mdx'",
    "test": "pnpm exec vitest run --test-timeout=10000",
    "test:one": "pnpm exec vitest related --run",
    "test:watch": "pnpm exec vitest"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dialpad/dialtone-emojis": "workspace:*",
    "@dialpad/dialtone-icons": "workspace:*",
    "@dialpad/i18n": "1.20.1",
    "@tiptap/core": "2.12.0",
    "@tiptap/extension-blockquote": "2.12.0",
    "@tiptap/extension-bold": "2.12.0",
    "@tiptap/extension-bubble-menu": "2.12.0",
    "@tiptap/extension-bullet-list": "2.12.0",
    "@tiptap/extension-code": "2.12.0",
    "@tiptap/extension-code-block": "2.12.0",
    "@tiptap/extension-color": "2.12.0",
    "@tiptap/extension-document": "2.12.0",
    "@tiptap/extension-floating-menu": "2.12.0",
    "@tiptap/extension-font-family": "2.12.0",
    "@tiptap/extension-hard-break": "2.12.0",
    "@tiptap/extension-history": "2.12.0",
    "@tiptap/extension-image": "2.12.0",
    "@tiptap/extension-italic": "2.12.0",
    "@tiptap/extension-link": "2.12.0",
    "@tiptap/extension-list-item": "2.12.0",
    "@tiptap/extension-mention": "2.12.0",
    "@tiptap/extension-ordered-list": "2.12.0",
    "@tiptap/extension-paragraph": "2.12.0",
    "@tiptap/extension-placeholder": "2.12.0",
    "@tiptap/extension-strike": "2.12.0",
    "@tiptap/extension-text": "2.12.0",
    "@tiptap/extension-text-align": "2.12.0",
    "@tiptap/extension-text-style": "2.12.0",
    "@tiptap/extension-underline": "2.12.0",
    "@tiptap/pm": "2.12.0",
    "@tiptap/suggestion": "2.12.0",
    "@tiptap/vue-3": "2.12.0",
    "date-fns": "4.1.0",
    "deep-equal": "2.2.3",
    "emoji-toolkit": "9.0.1",
    "linkifyjs": "4.3.2",
    "overlayscrollbars": "2.10.0",
    "regex-combined-emojis": "1.6.0",
    "tippy.js": "6.3.7",
    "turndown": "7.2.0"
  },
  "devDependencies": {
    "@dialpad/dialtone-css": "workspace:*",
    "@dialpad/generator-dialtone": "workspace:*",
    "@storybook/addon-a11y": "7.6.20",
    "@storybook/addon-essentials": "7.6.20",
    "@storybook/addon-links": "7.6.20",
    "@storybook/vue3": "7.6.20",
    "@storybook/vue3-vite": "7.6.20",
    "@vue/test-utils": "^2.4.0",
    "react": "^18.3.1",
    "storybook-dark-mode": "^3.0.3",
    "vue": "^3.3.4"
  },
  "peerDependencies": {
    "@dialpad/dialtone-css": "workspace:^",
    "vue": ">=3.2"
  },
  "bugs": {
    "email": "dialtone@dialpad.com"
  },
  "contributors": [
    {
      "name": "Brad Paugh",
      "email": "brad.paugh@dialpad.com",
      "url": "https://github.com/braddialpad"
    },
    {
      "name": "Francis Rupert",
      "email": "francis.rupert@dialpad.com",
      "url": "https://github.com/francisrupert"
    },
    {
      "name": "Ignacio Ropolo",
      "email": "ignacio.ropolo@dialpad.com",
      "url": "https://github.com/iropolo"
    },
    {
      "name": "Nina Repetto",
      "email": "nina.repetto@dialpad.com",
      "url": "https://github.com/ninamarina"
    }
  ],
  "engineStrict": true,
  "engines": {
    "node": ">= 14.17"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/dialtone-vue.cjs",
  "module": "./dist/dialtone-vue.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dialtone-vue.js",
      "require": "./dist/dialtone-vue.cjs"
    },
    "./lib/*": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/*/index.js",
      "require": "./dist/lib/*/index.cjs"
    },
    "./component-documentation.json": "./dist/component-documentation.json",
    "./*": "./dist/*"
  },
  "nx": {
    "includedScripts": [
      "lint",
      "test"
    ]
  },
  "homepage": "https://dialtone.dialpad.com/vue3",
  "keywords": [
    "Dialpad",
    "Dialtone",
    "Dialtone Vue",
    "Design System",
    "Components",
    "Component Library",
    "Vue",
    "Storybook"
  ],
  "license": "MIT",
  "sideEffects": false
}
