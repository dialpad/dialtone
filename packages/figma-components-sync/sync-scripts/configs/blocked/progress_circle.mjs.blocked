/**
 * DtProgressCircle.
 *
 * Axes are the PROP API (ProgressCircle.vue's props block): `ariaLabel`,
 * `progress`, `size`, `kind`. ProgressCircleConstants.js maps sizes and kinds to
 * CSS modifier names, but the PROP values are what this sweeps — the modifier
 * map is the CSS side of the same axis, not a second one.
 *
 * Worth having in the set for a reason beyond coverage: this is the first
 * component here whose whole appearance is a VECTOR arc rather than a box with
 * paint on it, so it exercises the imported-SVG path — glyph fills, the frame's
 * own fill, and the arc geometry — harder than anything already synced.
 *
 * Deliberately NOT an axis:
 *   ariaLabel — required, and screen-reader only. It paints nothing, and
 *               sr-only nodes are dropped by the harness before they can become
 *               Figma nodes. Passed as a constant so the component renders.
 */
export default {
  component: 'DtProgressCircle', label: '', page: 'ProgressCircle',

  axes: {
    // Four points rather than every integer: the arc's SWEEP is a continuous
    // function of this prop, so sampling it is the only sensible approach.
    // 0 and 100 are the endpoints (empty and full, which are the two cases most
    // likely to be special-cased in CSS or in the arc maths), and 33/66 catch a
    // partial arc in each half. If a fifth value ever turns up a defect these
    // four missed, that is an argument for more samples with a reason attached.
    progress: [0, 33, 66, 100],
    // Every documented size. Sizes are cheap and they are exactly where a
    // vector component can go wrong — an arc that scales by the wrong factor
    // looks plausible at one size and obviously off at another.
    size: [100, 200, 300, 400, 500, 600, 700],
    // Every documented kind. `default` is the empty modifier, so it is the
    // no-class case; the rest each swap the arc's colour.
    kind: ['default', 'brand', 'critical', 'positive', 'warning', 'info', 'ai'],
  },

  // Nothing to exclude yet. Every progress × size × kind renders, and no pair is
  // KNOWN to be pixel-identical. Pruning on the assumption that, say, progress
  // does not interact with kind would be a guess, and guesses of exactly that
  // shape are how several bugs in this project's log got in. If the built set
  // turns out to hold identical variants, the exclusion goes here WITH the
  // measurement that justifies it.
  invalid: () => false,

  props: c => ({
    ariaLabel: 'Progress',
    progress: c.progress,
    size: c.size,
    kind: c.kind,
  }),

  variantName: c => `progress=${c.progress}, size=${c.size}, kind=${c.kind}`,
};
