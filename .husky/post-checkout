#!/usr/bin/env bash
. "$(dirname "$0")/_/husky.sh"

# Post-checkout hook: Clean dist directories when switching branches
# This prevents stale build artifacts from polluting your workspace

# Arguments passed by git:
# $1 = previous HEAD
# $2 = new HEAD
# $3 = flag indicating whether this was a branch checkout (1) or file checkout (0)

# Only run on branch checkouts
if [ "$3" = "1" ]; then
  echo "🧹 Branch switched - cleaning dist directories..."

  # Clean dialtone-tokens dist
  if [ -d "packages/dialtone-tokens/dist" ]; then
    rm -rf packages/dialtone-tokens/dist
    echo "  ✓ Cleaned packages/dialtone-tokens/dist"
  fi

  echo "  💡 Tip: Run builds to regenerate dist files for this branch"
fi
