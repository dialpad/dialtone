#!/usr/bin/env bash
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit hook"

if ! git diff --staged --quiet packages/dialtone-icons/src; then
  echo "Detected changes to icons, rebuilding..."
  pnpm nx run dialtone-icons:build;

  git add packages/dialtone-icons/src/keywords-*;
fi

if ! git diff --staged --quiet .vscode/extensions.json; then
  echo "Syncing devcontainer extensions from extensions.json..."
  node scripts/sync-vscode-extensions.mjs
fi

# Regenerate component wall thumbnails when a relevant input changed.
# The generator's content-hash cache means only affected slugs actually
# rerun — typical single-component commits regen in ~5–10s warm.
THUMB_INPUTS='packages/dialtone-vue/components apps/dialtone-documentation/thumbs packages/combinator/src/variants packages/dialtone-tokens'
if ! git diff --staged --quiet -- $THUMB_INPUTS; then
  echo "Detected changes to thumb inputs, regenerating component thumbnails..."
  echo "  This auto-stages updated PNGs. Cache: warm regen ~5–10s, cold ~3 min."
  echo "  Trouble? See apps/dialtone-documentation/thumbs/README.md#pre-commit-hook"
  pnpm nx run dialtone-documentation:thumbs;

  git add apps/dialtone-documentation/docs/.vuepress/public/assets/images/components;
fi

# Regenerate token-derived docs data when a source that feeds it changed.
# generate-token-data dependsOn dialtone-tokens:build, so token edits get a fresh doc.json first.
DATA_INPUTS='packages/dialtone-tokens/tokens packages/dialtone-tokens/postcss/constants.cjs packages/dialtone-css/postcss/constants.cjs apps/dialtone-documentation/scripts/data apps/dialtone-documentation/scripts/generate-data.mjs'
if ! git diff --staged --quiet -- $DATA_INPUTS; then
  echo "Detected changes to docs-data inputs, regenerating token-derived _data files..."
  pnpm nx run dialtone-documentation:generate-token-data;

  git add apps/dialtone-documentation/docs/_data/spacing.json \
          apps/dialtone-documentation/docs/_data/gap.json \
          apps/dialtone-documentation/docs/_data/width-height.json \
          apps/dialtone-documentation/docs/_data/icons-sizes.json \
          apps/dialtone-documentation/docs/_data/z-index.json;
fi

pnpm exec lint-staged --relative
