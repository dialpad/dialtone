{
  "name": "@dialpad/dialtone",
  "version": "10.0.0-next.4",
  "packageManager": "pnpm@11.9.0",
  "description": "Dialpad's Dialtone design system monorepo",
  "scripts": {
    "prepare": "husky install",
    "prepack": "nx run dialtone:build",
    "clean": "pnpm clean:dist && pnpm clean:cache",
    "clean:dist": "rm -rf packages/dialtone-tokens/dist apps/dialtone-documentation/docs/.vuepress/.cache apps/dialtone-documentation/docs/.vuepress/.temp",
    "clean:cache": "pnpm nx reset --onlyCache"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "dialtone-migrate": "./dist/js/dialtone_migrate/index.mjs",
    "dialtone-migrate-flex-to-stack": "./dist/js/dialtone_migrate_flex_to_stack/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./CHANGELOG.json": "./CHANGELOG.json",
    "./css": "./dist/css/dialtone.min.css",
    "./css-default-theme": "./dist/css/dialtone-default-theme.min.css",
    "./css/no-layers": "./dist/css/no-layers/dialtone.min.css",
    "./css/no-layers/default-theme": "./dist/css/no-layers/dialtone-default-theme.min.css",
    "./tokens/*.css": "./dist/tokens/css/*.css",
    "./tokens/postcss/*": {
      "types": "./dist/tokens/types/postcss/*.d.ts",
      "import": "./dist/tokens/postcss/*.js",
      "require": "./dist/tokens/postcss/*.cjs"
    },
    "./vue": {
      "types": "./dist/vue3/index.d.ts",
      "import": "./dist/vue3/dialtone-vue.js",
      "require": "./dist/vue3/dialtone-vue.cjs"
    },
    "./vue/lib/*": {
      "types": "./dist/vue3/index.d.ts",
      "import": "./dist/vue3/lib/*/index.js",
      "require": "./dist/vue3/lib/*/index.cjs"
    },
    "./vue3": {
      "types": "./dist/vue3/index.d.ts",
      "import": "./dist/vue3/dialtone-vue.js",
      "require": "./dist/vue3/dialtone-vue.cjs"
    },
    "./vue3/lib/*": {
      "types": "./dist/vue3/index.d.ts",
      "import": "./dist/vue3/lib/*/index.js",
      "require": "./dist/vue3/lib/*/index.cjs"
    },
    "./themes/*": {
      "types": "./dist/tokens/types/themes/*.d.ts",
      "import": "./dist/tokens/themes/*.js",
      "require": "./dist/tokens/themes/*.cjs"
    },
    "./fonts": "./dist/css/fonts.js",
    "./*": "./dist/*"
  },
  "dependencies": {
    "@dialpad/dialtone-emojis": "workspace:*",
    "@dialpad/dialtone-icons": "workspace:*",
    "@dialpad/dialtone-mcp-server": "workspace:*",
    "@dialpad/dialtone-tokens": "workspace:*",
    "@dialpad/i18n": "1.25.3",
    "@floating-ui/dom": "^1.6.0",
    "@tiptap/core": "3.19.0",
    "@tiptap/extension-blockquote": "3.19.0",
    "@tiptap/extension-bold": "3.19.0",
    "@tiptap/extension-bubble-menu": "3.19.0",
    "@tiptap/extension-code": "3.19.0",
    "@tiptap/extension-code-block": "3.19.0",
    "@tiptap/extension-color": "3.19.0",
    "@tiptap/extension-document": "3.19.0",
    "@tiptap/extension-floating-menu": "3.19.0",
    "@tiptap/extension-font-family": "3.19.0",
    "@tiptap/extension-hard-break": "3.19.0",
    "@tiptap/extension-image": "3.19.0",
    "@tiptap/extension-italic": "3.19.0",
    "@tiptap/extension-link": "3.19.0",
    "@tiptap/extension-list": "3.19",
    "@tiptap/extension-mention": "3.19.0",
    "@tiptap/extension-paragraph": "3.19.0",
    "@tiptap/extension-strike": "3.19.0",
    "@tiptap/extension-table": "3.19.0",
    "@tiptap/extension-text": "3.19.0",
    "@tiptap/extension-text-align": "3.19.0",
    "@tiptap/extension-text-style": "3.19.0",
    "@tiptap/extension-underline": "3.19.0",
    "@tiptap/extensions": "3.19",
    "@tiptap/pm": "3.19.0",
    "@tiptap/suggestion": "3.19.0",
    "date-fns": "4.1.0",
    "deep-equal": "2.2.3",
    "docopt": "0.6.2",
    "emoji-toolkit": "9.0.1",
    "globals": "16.3.0",
    "linkifyjs": "4.3.2",
    "overlayscrollbars": "2.10.0",
    "regex-combined-emojis": "1.6.0",
    "tippy.js": "6.3.7",
    "vue-tsc": "3.2.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^17.6.6",
    "@dialpad/conventional-changelog-angular": "^1.1.1",
    "@dialpad/dialtone-cli": "workspace:*",
    "@dialpad/semantic-release-changelog-json": "^1.0.0",
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "8.4.1",
    "@percy/cli": "1.30.9",
    "@percy/storybook": "6.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.4.5",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/tsconfig": "^0.4.0",
    "axe-core": "^4.7.2",
    "axe-playwright": "^2.0.3",
    "c8": "^8.0.0",
    "colorjs.io": "0.4.5",
    "concurrently": "^8.2.2",
    "del": "^6.1.1",
    "eslint": "^9.33.0",
    "eslint-plugin-eslint-plugin": "6.3.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-storybook": "10.3.0",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "glob": "^11.0.3",
    "gulp": "^4.0.2",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-svgmin": "^4.1.0",
    "http-server": "^14.1.1",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.0",
    "markdownlint": "^0.38.0",
    "markdownlint-cli": "^0.45.0",
    "npm-run-all": "^4.1.5",
    "nx": "19.8.0",
    "playwright": "^1.60.0",
    "semantic-release": "^21.0.6",
    "semantic-release-plus": "^20.0.0",
    "stylelint": "^16.25.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-less": "^3.0.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-less": "^3.0.1",
    "stylelint-no-px": "^1.0.1",
    "tinycolor2": "^1.6.0",
    "typedoc": "^0.28.2",
    "typedoc-plugin-markdown": "^4.6.1",
    "typescript": "^5.2",
    "vite": "^8.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0",
    "vue-docgen-api": "^4.75.0",
    "vue-template-compiler": "^2.7.16",
    "wait-on": "^7.2.0",
    "yo": "^5.0.0"
  },
  "engines": {
    "pnpm": ">=11.9.0"
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "homepage": "https://dialtone.dialpad.com",
  "keywords": [
    "Dialpad",
    "Dialtone",
    "Dialtone Vue",
    "Dialtone Icons",
    "Dialtone Tokens",
    "Design System",
    "Components",
    "Component Library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dialpad/dialtone.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/css/**/*.css",
    "./dist/css/fonts.js"
  ],
  "nx": {
    "includedScripts": []
  }
}
